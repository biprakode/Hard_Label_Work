# Hard_Label_Work residual / intermediate files — never commit any of these.
# Generated by the extraction pipeline at run time; restored by re-running.

# ---------------------------------------------------------------- byte code --
__pycache__/
*.pyc
*.pyo

# --------------------------------- Phase 1 — signature_recovery intermediate --
# Raw dual-point pickles produced by find_duals.py (each ~10 MB, ~10 GB / 1000 iters)
signature_recovery/exp/*/
# Per-layer clustered triplet pickles produced by cluster_dual_points_stream.py
signature_recovery/exp/1-cluster-*.p
# Per-neuron weight files produced by recover_weights.py
signature_recovery/outputs/model_weights/Vrelu/layer_*/
# recover_weights.py text logs
signature_recovery/[0-9]_weight_vectors.txt
signature_recovery/*_weight_vectors.txt

# -------------------------------------- Phase 2 — sign_recovery intermediate --
# Per-neuron dual files produced by generate_dual_neuron.py
sign_recovery/layer_neuron_npys/*.npy
# sign_recovery.py per-neuron analysis output
sign_recovery/results/

# --------------------------------- Phase 3 — reconstructed-model output --
# Generated by analysis/run_extraction.py
results/sign_recovery/*.npy
results/sign_recovery/*.json
results/reconstructed_models/reconstructed_*.pth
results/reconstructed_models/reconstructed_*.npz
results/reconstructed_models/extraction_metrics.json
results/reconstructed_models/makeblobs_eval.json
# Older per-model snapshot dirs from manual experiments
results/model_*/
results/reconstructed_models_test_*/
results/reconstructed_models_*_verify/

# -------------------------------------- generated reports / logs / json --
# Per-run markdown reports produced by the eval/extraction scripts
results/reports/*.md
# All run-time logs and JSON dumps anywhere in the tree
*.log
*.json

# -------------------------------------- baseline / backup directories --
_relu_baseline_backup/
signature_output/

# -------------------------------------- entire results tree --
# Everything under any results* path is attack output only; nothing is read
# back from it by the pipeline, so ignore the whole tree wholesale.
results*

# -------------------------------------- editor / OS noise --
.DS_Store
*.swp
*.swo
.vscode/
.idea/
